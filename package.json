{
  "name": "coinslite",
  "private": true,
  "workspaces": ["packages/*", "apps/*", "tooling/*"],
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@coinslite/web",
    "dev:app": "turbo dev --filter=@coinslite/app",
    "start:web": "turbo start --filter=@coinslite/web",
    "start:app": "turbo start --filter=@coinslite/app",
    "format": "biome format --write .",
    "lint": "turbo lint && bun lint:repo",
    "lint:repo": "sherif --fail-on-warnings",
    "lint:repo:fix": "sherif --fix --fail-on-warnings",
    "typecheck": "turbo typecheck",
    "test": "bun test",
    "dev:backend": "turbo dev --filter=@coinslite/backend",
    "setup": "bun --filter @coinslite/backend setup",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "sherif": "1.13.0",
    "tslib": "^2.8.1",
    "turbo": "2.11.7",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.2",
  "version": "0.0.1"
}
