{
  "name": "coinslite",
  "private": true,
  "workspaces": ["packages/*", "apps/*", "tooling/*"],
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev --parallel",
    "dev:web": "turbo dev --filter=@coinslite/web",
    "dev:app": "turbo dev --filter=@coinslite/app",
    "start:web": "turbo start --filter=@coinslite/web",
    "start:app": "turbo start --filter=@coinslite/app",
    "test": "turbo test",
    "format": "biome format --write .",
    "lint": "turbo lint && bun lint:repo",
    "lint:repo": "sherif --fail-on-warnings",
    "lint:repo:fix": "sherif --fix --fail-on-warnings",
    "typecheck": "turbo typecheck",
    "dev:backend": "turbo dev --filter=@coinslite/backend",
    "setup": "bun --filter @coinslite/backend setup",
    "test:e2e": "playwright test -c tooling/e2e/playwright.config.ts",
    "test:e2e:local": "E2E_LOCAL_BACKEND=1 E2E_APP_PORT=3300 E2E_WEB_PORT=3301 playwright test -c tooling/e2e/playwright.config.ts",
    "verify": "bash scripts/verify.sh",
    "format:check": "biome format .",
    "hooks:install": "bash scripts/install-hooks.sh",
    "prepare": "bun run hooks:install"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@t3-oss/env-nextjs": "^0.11.1",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "ora": "^5.4.1",
    "sherif": "1.13.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.19.1",
    "turbo": "2.11.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "version": "0.0.1",
  "patchedDependencies": {
    "@xixixao/uploadstuff@0.0.5": "patches/@xixixao%2Fuploadstuff@0.0.5.patch"
  }
}
